# OpsArena Sandbox: Isolated CloudMesh simulation container.
# Strict sandbox boundaries: Runs unprivileged user (UID 1000), internal network only (no internet route).
FROM python:3.12-slim

RUN useradd --create-home --uid 1000 sandbox \
 && mkdir /workspace && chown sandbox:sandbox /workspace

COPY sandbox /opt/sandbox

USER sandbox
WORKDIR /workspace

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt

EXPOSE 8000

CMD ["python", "/opt/sandbox/server.py"]
